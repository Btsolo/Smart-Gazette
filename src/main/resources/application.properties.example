spring.application.name=Smart Gazette
# --- Database Connection ---
spring.datasource.url=jdbc:postgresql://localhost:ghgh/smart_gazette
spring.datasource.username=postgres
spring.datasource.password=root

# --- JPA Settings ---
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# --- Server Settings (optional) ---
server.port=8081
spring.thymeleaf.cache=false

#upload limits
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB

# Groq - handles all text calls (triage, extraction, generation)
groq.api.key=fbhththtyhtght
groq.model.pro=llama-3.3-70b-versatile
groq.model.flash=llama-3.1-8b-instant

# Gemini - handles vision OCR only (one call per PDF)
gemini.api.key=AQ.rgggtrertetr
gemini.model.ocr=gemini-2.5-flash
gemini.model.flashLite=gemini-3.1-flash-lite

#Ifttt Info
ifttt.webhook.url=https://maker.ifttt.com/trigger/<event>/with/key/<your-key>
# --- Extraction (lessons 35, 42, 53-55) ---
# inspector = positions extractor (tools/inspect_positions.js, needs Node + `npm ci` in tools/
# and poppler's pdftocairo); legacy = the old PDFBox path. Production must use inspector.
extraction.engine=inspector
extraction.inspector.script=/app/tools/inspect_positions.js
extraction.inspector.node=node
extraction.inspector.timeout-seconds=300
# scan lane: Tesseract + poppler (pdfimages, pdftoppm) on the PATH, or full paths here
extraction.scan.enabled=true
extraction.scan.workers=4
extraction.scan.dpi=300
extraction.scan.tesseract=tesseract
extraction.scan.pdftoppm=pdftoppm
extraction.scan.pdfimages=pdfimages

# --- Figures (docs/specs/figures.md) ---
# figures.dir and storage/gazettes/ must be persistent volumes on a server
figures.enabled=true
figures.dir=/data/figures
figures.dpi=200
# PP-OCRv6 models + character list (tools/fetch_ocr_models.py, SHA256SUMS); without them
# figures fall back to Tesseract
figures.ocr.models-dir=/app/models/ppocr

# --- Switches for a deployment ---
# admin pages (upload / edit / delete) have no real login yet: off = read-only site (default)
admin.enabled=false
# the nightly Kenya Law scrape (default on): every day at 22:00 Nairobi time, checks the newest
# few gazettes and processes each new one, one at a time, 5 s between requests
scraper.enabled=true
scraper.cron=0 0 22 * * *
scraper.zone=Africa/Nairobi
scraper.max-per-run=5
scraper.pause-seconds=5
# the nightly retry of notices that failed (mostly AI-call failures): 03:00 Nairobi time, through
# the same pipeline as a new gazette (templates first, then AI); each notice at most 3 times
retry.enabled=true
retry.cron=0 0 3 * * *
retry.zone=Africa/Nairobi
retry.max-per-run=100
retry.max-attempts=3
# how the scraper names itself to Kenya Law (honest identification, no browser disguise)
scraper.user-agent=SmartGazette/1.0 (+https://github.com/Btsolo/Smart-Gazette)
# social posting through IFTTT (default off; ifttt.webhook.url is then not needed)
social.posting.enabled=false
